PORT=8080
WEB_ORIGIN=http://localhost:5173

# Supabase: Project settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Developer API key (aistudio.google.com). Always needed: the voice interview uses it.
GEMINI_API_KEY=

# Set to true to run repository analysis and scoring through Vertex AI (uses Google Cloud credits).
# Needs `gcloud auth application-default login` locally, or a service account on Cloud Run.
USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Only where gcloud is not available (Vercel): the content of a service account key with the Vertex AI User role, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional but recommended: raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Background jobs.
# Locally, leave TASKS_QUEUE empty and jobs run inside the API process.
# On Vercel, set INTERNAL_SECRET (any random string of 16+ characters) and API_PUBLIC_URL (the API's production URL):
# each job then runs in its own function invocation. CRON_SECRET protects the daily Vercel cron.
TASKS_QUEUE=
TASKS_LOCATION=us-central1
TASKS_SERVICE_ACCOUNT=
API_PUBLIC_URL=
INTERNAL_SECRET=
CRON_SECRET=

# AI load limits (optional, defaults shown). Lower them if Gemini keeps answering 503 or 429.
# JUDGE_CONCURRENCY=1
# GEMINI_CONCURRENCY=2
# GEMINI_MIN_GAP_MS=400
# GEMINI_TIMEOUT_MS=120000
# REPO_TOKEN_BUDGET=40000
# REPO_SMALL_REPO_TOKENS=50000
# REPO_MAX_FULL_FILES=30
# REPO_MAX_SUMMARISED_FILES=20

# Models (optional). Main model and backups, comma separated, tried in order.
# GEMINI_MODEL_ANALYSIS=gemini-3.8-flash
# GEMINI_FALLBACKS_ANALYSIS=gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_MODEL_SUMMARIES=gemini-3.5-flash-lite
# GEMINI_FALLBACKS_SUMMARIES=gemini-3.1-flash-lite
# When every model is busy, also try the other provider (Vertex AI or the API key). Needs both configured.
# GEMINI_CROSS_PROVIDER=false
