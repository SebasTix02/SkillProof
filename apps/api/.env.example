PORT=8080
WEB_ORIGIN=http://localhost:5173

# Supabase: Project settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Developer API key (aistudio.google.com). Always needed: the voice interview uses it.
GEMINI_API_KEY=

# Set to true to run repository analysis and scoring through Vertex AI (uses Google Cloud credits).
# Needs `gcloud auth application-default login` locally, or a service account on Cloud Run.
USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional but recommended: raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Background jobs. Leave TASKS_QUEUE empty to run them inside the API process (local development).
TASKS_QUEUE=
TASKS_LOCATION=us-central1
TASKS_SERVICE_ACCOUNT=
API_PUBLIC_URL=
INTERNAL_SECRET=
